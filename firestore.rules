rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.ativo == true &&
        get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.papel == 'admin';
    }
    match /ferramentas/{id} {
      allow get, list: if isAdmin() || resource.data.publicado == true;
      allow create, update, delete: if isAdmin();
    }
    match /docentes/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, create, update, delete: if isAdmin();
    }
    match /administradores/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
  }
}
